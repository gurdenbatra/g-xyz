---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Garden from '@layouts/Garden.astro';
import SlowPlot from '@components/zones/Flora/SlowPlot.astro';
import { skills } from '../../lib/skills';

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => b.data.year - a.data.year);
---

<Garden
  title="The Flora & Fauna"
  description="Work and projects by Gurden Batra — civic tech, design, and development — rendered as a wild plot."
>
  <section class="poly-wrap page-wrap">
    <header class="poly-header">
      <p class="label">The Flora &amp; Fauna</p>
      <h1 class="poly-title">A wild plot of work.</h1>
      <p class="poly-subtitle">
        Each plant is a project. Hover to see its name; click to walk into it.
      </p>
    </header>

    <SlowPlot />

    <!-- The plot is the desktop interface (hover + click). This list is its
         a11y equivalent AND the primary, tappable project index on touch,
         where there is no hover. Visually hidden on desktop; shown ≤640px. -->
    <nav class="projects-index" aria-label="Projects">
      <h2 class="projects-index__title label">Projects</h2>
      <ol class="projects-index__list">
        {sorted.map((p) => {
          const slug = p.id.replace(/\.[^.]+$/, '');
          return (
            <li>
              <a href={`/flora/${slug}`}>
                {p.data.heroImage && (
                  <Image
                    class="pi-thumb"
                    src={p.data.heroImage}
                    alt=""
                    widths={[192, 384]}
                    sizes="96px"
                    loading="lazy"
                  />
                )}
                <span class="pi-title">{p.data.title}</span>
                <span class="pi-year label">{p.data.year}</span>
                <span class="pi-desc">{p.data.description}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>

    <section class="skills-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="label section-heading">What I do</h2>
      <p class="skills-intro">
        A generalist's toolkit — I take civic ideas from zero to shipped, across:
      </p>
      <ul class="skills-list" role="list">
        {skills.map((skill) => <li class="skill label">{skill}</li>)}
      </ul>
    </section>
  </section>
</Garden>

<style>
  .poly-wrap {
    padding-block: var(--space-12) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .poly-header { display: flex; flex-direction: column; gap: var(--space-3); }
  .poly-title {
    font-family: 'MaziusDisplay', serif;
    font-style: italic;
    font-size: var(--text-3xl);
    line-height: 1.05;
    margin: 0;
  }
  .poly-subtitle {
    font-size: var(--text-md);
    color: var(--ink-muted);
    max-width: 50ch;
    margin: 0;
  }
  /* Desktop: visually hidden (the plot is the interface); stays in the a11y tree. */
  .projects-index {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Touch: no hover — reveal the list as the primary, tappable project index. */
  @media (max-width: 640px) {
    .projects-index {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
    .projects-index__title {
      display: block;
      margin-bottom: var(--space-4);
    }
    .projects-index__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .projects-index__list li {
      margin: 0;
    }
    .projects-index__list a {
      display: grid;
      grid-template-columns: 96px 1fr auto;
      grid-template-rows: auto auto;
      gap: var(--space-1) var(--space-3);
      align-items: baseline;
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--ink-faint);
      text-decoration: none;
      color: var(--ink);
    }
    .projects-index__list a:has(.pi-thumb) .pi-desc {
      grid-column: 2 / -1;
    }
    .projects-index__list a:not(:has(.pi-thumb)) {
      grid-template-columns: 1fr auto;
    }
    .projects-index__list :global(.pi-thumb) {
      grid-row: 1 / span 2;
      align-self: start;
      width: 96px;
      height: 60px;
      object-fit: cover;
      object-position: top;
      border: 1px solid var(--ink-faint);
    }
    .pi-title {
      font-family: 'MaziusDisplay', serif;
      font-style: italic;
      font-size: var(--text-md);
    }
    .pi-year {
      color: var(--ink-muted);
      text-align: right;
    }
    .pi-desc {
      grid-column: 1 / -1;
      font-size: var(--text-sm);
      color: var(--ink-muted);
      line-height: 1.5;
    }
  }

  .skills-section {
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }
  .section-heading { display: block; margin-bottom: var(--space-6); }
  .skills-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: var(--space-8);
  }
  .skills-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .skill {
    border: 1px solid var(--ink-muted);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-xs);
  }
</style>
