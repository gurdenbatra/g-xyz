---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Garden from '@layouts/Garden.astro';
import SlowPlot from '@components/zones/Flora/SlowPlot.astro';

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => b.data.year - a.data.year);
---

<Garden
  title="The Flora & Fauna"
  description="Work and projects by Gurden Batra — civic tech, design, and development — rendered as a wild plot."
>
  <section class="poly-wrap page-wrap">
    <header class="poly-header">
      <p class="label">The Flora &amp; Fauna</p>
      <h1 class="poly-title">A wild plot of work.</h1>
      <!-- DRAFT (your voice) — edit freely; see docs/COPY-REVIEW.md -->
      <p class="poly-subtitle">
        Most of this is civic tech: tools for councils, cities and the people who
        have to live with what they decide. Each plant is a project — hover for
        its name, click to walk in. The actual screenshots are below, because a
        plot of ASCII plants only says so much.
      </p>
    </header>

    <SlowPlot />

    <!-- The real work: a grid of screenshots on desktop, a tappable row list on
         phones. Also the keyboard/screen-reader equivalent of the plot above. -->
    <nav class="projects-index" aria-label="Projects">
      <h2 class="projects-index__title section-heading">The work</h2>
      <ol class="projects-index__list">
        {sorted.map((p) => {
          const slug = p.id.replace(/\.[^.]+$/, '');
          return (
            <li>
              <a href={`/flora/${slug}`}>
                {p.data.heroImage && (
                  <Image
                    class="pi-thumb"
                    src={p.data.heroImage}
                    alt=""
                    widths={[400, 800]}
                    sizes="(max-width: 640px) 96px, 400px"
                    loading="lazy"
                  />
                )}
                <span class="pi-title">{p.data.title}</span>
                <span class="pi-year label">{p.data.year}</span>
                <span class="pi-desc">{p.data.description}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>

    <section class="skills-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-heading">What I do</h2>
      <!-- DRAFT (your voice) — edit freely; see docs/COPY-REVIEW.md -->
      <p class="skills-intro">
        I'm a generalist on purpose. I write the code — full-stack, and lately a
        lot of LLM and agent plumbing — I do the product and service design, I
        prototype fast and throw most of it away, and I've written more bids and
        partner emails than I'd like to admit. If a civic idea needs to go from
        zero to something a council can actually use, that's the part I'm for.
      </p>
    </section>
  </section>
</Garden>

<style>
  .poly-wrap {
    padding-block: var(--space-12) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .poly-header { display: flex; flex-direction: column; gap: var(--space-3); }
  .poly-title {
    font-family: 'MaziusDisplay', serif;
    font-style: italic;
    font-size: var(--text-3xl);
    line-height: 1.05;
    margin: 0;
  }
  .poly-subtitle {
    font-size: var(--text-md);
    color: var(--ink-muted);
    max-width: 50ch;
    margin: 0;
  }
  /* The work, as real artifacts: a grid of screenshots on desktop, a tappable
     row list on phones. Doubles as the keyboard/screen-reader equivalent of
     the plot. Slightly off-square thumbnails — pinned, not templated. */
  .projects-index {
    margin-top: var(--space-2);
  }
  .projects-index__title {
    display: block;
    margin-bottom: var(--space-6);
  }
  .projects-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-10) var(--space-6);
  }
  .projects-index__list li {
    margin: 0;
  }
  .projects-index__list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    text-decoration: none;
    color: var(--ink);
  }
  .projects-index__list :global(.pi-thumb) {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--ink-faint);
    box-shadow: 2px 3px 10px rgba(26, 26, 26, 0.1);
    margin-bottom: var(--space-3);
    transform: rotate(-0.35deg);
    transition: transform var(--duration-base) var(--easing);
  }
  .projects-index__list li:nth-child(3n) :global(.pi-thumb) {
    transform: rotate(0.4deg);
  }
  .projects-index__list li:nth-child(3n + 2) :global(.pi-thumb) {
    transform: rotate(-0.15deg);
  }
  .projects-index__list a:hover :global(.pi-thumb),
  .projects-index__list a:focus-visible :global(.pi-thumb) {
    transform: rotate(0deg) translateY(-2px);
  }
  .pi-title {
    font-family: 'MaziusDisplay', serif;
    font-style: italic;
    font-size: var(--text-md);
  }
  .pi-year {
    color: var(--ink-muted);
    text-align: right;
  }
  .pi-desc {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .projects-index__list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .projects-index__list a {
      grid-template-columns: 96px 1fr auto;
      grid-template-rows: auto auto;
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--ink-faint);
    }
    .projects-index__list a:has(.pi-thumb) .pi-desc {
      grid-column: 2 / -1;
    }
    .projects-index__list a:not(:has(.pi-thumb)) {
      grid-template-columns: 1fr auto;
    }
    .projects-index__list :global(.pi-thumb) {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: start;
      width: 96px;
      height: 60px;
      aspect-ratio: auto;
      margin-bottom: 0;
      box-shadow: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-index__list :global(.pi-thumb) {
      transition: none;
    }
  }

  .skills-section {
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }
  .section-heading { display: block; margin-bottom: var(--space-6); }
  .skills-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: var(--space-8);
  }
</style>
