---
import Garden from '@layouts/Garden.astro';
import Strata from '../../components/zones/Roots/Strata.astro';
---

<Garden
  title="The Roots"
  description="The layered strata of a life: origins, education, and the work they grew into."
>
  <div class="roots-wrap page-wrap">

    <header class="roots-header">
      <h1>The Roots</h1>
      <p class="roots-intro">
        Civic Tech Lead at Dark Matter Labs, Berlin. Background in Computer Science
        (Georgia Tech) and New Media Design (Aalto University). Originally from Delhi.
      </p>
    </header>

    <div class="strata-section" aria-labelledby="strata-heading">
      <h2 id="strata-heading" class="label section-heading">Strata</h2>
      <Strata />
    </div>

    <p class="roots-footnote">
      Want to reach out, or see what's growing right now? That all lives in
      <a href="/hive">The Hive</a>.
    </p>

  </div>
</Garden>

<style>
  .roots-wrap {
    padding-block: var(--space-16);
  }

  .roots-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .roots-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .roots-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  .strata-section {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--ink-faint);
  }

  .roots-footnote {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    color: var(--ink-muted);
  }

  .roots-footnote a {
    color: var(--ink);
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--easing);
  }

  .roots-footnote a:hover {
    color: var(--ink-muted);
  }
</style>
