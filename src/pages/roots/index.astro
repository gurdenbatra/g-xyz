---
import Garden from '@layouts/Garden.astro';
import Strata from '../../components/zones/Roots/Strata.astro';
import { experience } from '../../lib/experience';
---

<Garden
  title="The Roots"
  description="The layered strata of a life: origins, education, and the work they grew into."
>
  <div class="roots-wrap page-wrap">

    <header class="roots-header">
      <h1>The Roots</h1>
      <p class="roots-intro">
        Civic Tech Lead at Dark Matter Labs, Berlin. Background in Computer Science
        (Georgia Tech) and New Media Design (Aalto University). Originally from Delhi.
      </p>
    </header>

    <div class="strata-section" aria-labelledby="strata-heading">
      <h2 id="strata-heading" class="label section-heading">Strata</h2>
      <Strata />
    </div>

    <section class="experience-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="label section-heading">Experience</h2>
      <ul class="experience-list" role="list">
        {experience.map((role) => (
          <li class="role">
            <div class="role-main">
              <span class="role-title">{role.title}</span>
              <span class="role-org">{role.org}{role.location && `, ${role.location}`}</span>
            </div>
            <span class="role-period label">{role.period}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="roots-footnote">
      Want to reach out, or see what's growing right now? That all lives in
      <a href="/hive">The Hive</a>.
    </p>

  </div>
</Garden>

<style>
  .roots-wrap {
    padding-block: var(--space-16);
  }

  .roots-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .roots-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .roots-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  .strata-section {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--ink-faint);
  }

  .experience-section {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--ink-faint);
  }

  .experience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 640px;
  }

  .role {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .role-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-title {
    font-size: var(--text-md);
    font-style: italic;
    color: var(--ink);
  }

  .role-org {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .role-period {
    color: var(--ink-muted);
    white-space: nowrap;
    text-align: right;
  }

  .roots-footnote {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    color: var(--ink-muted);
  }

  .roots-footnote a {
    color: var(--ink);
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--easing);
  }

  .roots-footnote a:hover {
    color: var(--ink-muted);
  }
</style>
