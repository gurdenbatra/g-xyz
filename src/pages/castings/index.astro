---
import Garden from '@layouts/Garden.astro';
import TendedBeds from '../../components/zones/Castings/TendedBeds.astro';
---

<Garden
  title="The Compost"
  description="Design & tech details, care protocols, and the commitments behind gurden.xyz."
>
  <div class="castings-wrap page-wrap">

    <header class="castings-header">
      <h1>The Compost</h1>
      <!-- DRAFT (your voice) — edit freely; see docs/COPY-REVIEW.md -->
      <p class="castings-intro">
        How this site is built and looked after. No analytics, no third-party
        scripts, self-hosted fonts, a contrast test that runs in both light and
        dark — and a lot of pairing with Claude Code. The beds below hold the
        details.
      </p>
    </header>

    <section class="tended-section" aria-labelledby="tended-heading">
      <h2 id="tended-heading" class="section-heading">Tended Beds</h2>
      <TendedBeds />
    </section>

  </div>
</Garden>

<style>
  .castings-wrap {
    padding-block: var(--space-16);
  }

  .castings-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .castings-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .castings-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  .tended-section {
    margin-bottom: var(--space-20);
  }
</style>
