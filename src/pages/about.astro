---
import Base from '@layouts/Base.astro';
---

<Base
  title="About"
  description="Gurden Batra — Civic Tech Lead, Design Technologist, and builder of civic tools. Based in Berlin."
>
  <div class="about-wrap page-wrap">

    <div class="about-header">
      <p class="label">Gurden Batra</p>
      <h1>About</h1>
    </div>

    <div class="about-content">

      <p class="about-bio">
        Civic Tech Lead at Dark Matter Labs, Berlin. Building tools that help cities
        navigate the legal, ecological, and civic complexity of the 21st century.
        Background in Computer Science (Georgia Tech) and New Media Design (Aalto University).
      </p>

      <section class="journey-section" aria-labelledby="journey-heading">
        <h2 id="journey-heading" class="label section-heading">Background</h2>
        <ol class="timeline" role="list">
          <li class="timeline-item">
            <span class="timeline-year label">2020 –</span>
            <div class="timeline-body">
              <strong>Civic Tech Lead</strong>, Dark Matter Labs — Berlin.
              Leading development of civic tools for circular economy, urban forestry,
              and governance innovation. Projects include CircuLaw and TreesAI.
            </div>
          </li>
          <li class="timeline-item">
            <span class="timeline-year label">2015 – 17</span>
            <div class="timeline-body">
              <strong>M.S. New Media Design</strong>, Aalto University — Helsinki.
              Intersection of design, technology, and social systems.
            </div>
          </li>
          <li class="timeline-item">
            <span class="timeline-year label">2009 – 13</span>
            <div class="timeline-body">
              <strong>B.S. Computer Science</strong>, Georgia Tech — Atlanta.
            </div>
          </li>
          <li class="timeline-item">
            <span class="timeline-year label">Origin</span>
            <div class="timeline-body">
              Born and raised in Delhi, India.
            </div>
          </li>
        </ol>
      </section>

      <section class="contact-section" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="label section-heading">Get in touch</h2>
        <ul class="contact-list" role="list">
          <li>
            <a href="mailto:gurden@darkmatterlabs.org" class="contact-link label">
              gurden@darkmatterlabs.org
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/gurdenbatra"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link label"
            >
              LinkedIn <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/gurden"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link label"
            >
              GitHub <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/darkmatter_labs/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link label"
            >
              Instagram <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </section>

    </div>

  </div>
</Base>

<style>
  .about-wrap {
    padding-block: var(--space-16);
  }

  .about-header {
    margin-bottom: var(--space-12);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .about-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
  }

  .about-content {
    max-width: 640px;
  }

  .about-bio {
    font-size: var(--text-md);
    line-height: 1.65;
    margin-bottom: var(--space-16);
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  /* ── TIMELINE ── */
  .journey-section {
    margin-bottom: var(--space-16);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--ink-faint);
    align-items: start;
  }

  .timeline-year {
    color: var(--ink-muted);
    padding-top: 2px;
  }

  .timeline-body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--ink);
  }

  .timeline-body strong {
    font-style: italic;
  }

  /* ── CONTACT ── */
  .contact-section {
    margin-bottom: var(--space-16);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-link {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing);
  }

  .contact-link:hover {
    color: var(--ink-muted);
  }
</style>
