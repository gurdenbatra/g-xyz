---
import Garden from '@layouts/Garden.astro';
import LiveFlock from '../../components/zones/Hive/LiveFlock.astro';
import { talks } from '../../lib/talks';
---

<Garden
  title="The Hive"
  description="What I'm working on now, the practices behind it, how to reach me, and where I've spoken."
>
  <div class="hive-wrap page-wrap">

    <header class="hive-header">
      <h1>The Hive</h1>
      <!-- DRAFT (your voice) — edit freely; see docs/COPY-REVIEW.md -->
      <p class="hive-intro">
        This is the busy corner of the garden. What I'm carrying right now at
        Dark Matter Labs, the practices the work keeps pulling on, where I've
        spoken, and how to reach me — the email actually gets read.
      </p>
    </header>

    <section class="flock-section" aria-labelledby="flock-heading">
      <h2 id="flock-heading" class="section-heading">Live Swarm</h2>
      <LiveFlock />
    </section>

    <section class="hats-section" aria-labelledby="hats-heading">
      <h2 id="hats-heading" class="section-heading">One job title, several jobs</h2>
      <!-- DRAFT (your voice) — edit freely; see docs/COPY-REVIEW.md -->
      <p class="hats-intro">
        On paper I'm the Civic Tech Lead. In practice, at a small organisation
        like Dark Matter Labs, that means I also run IT, write strategy and bids,
        hold partner relationships, take ideas from zero to one, build the
        websites, and set up the AI and automation workflows the team runs on.
        Service design is in there too. Many hats — I like it that way.
      </p>
    </section>

    <section class="talks-section" aria-labelledby="talks-heading">
      <h2 id="talks-heading" class="section-heading">Talks</h2>
      <ul class="talks-list" role="list">
        {talks.map((talk) => (
          <li class="talk">
            <a
              class="talk-venue"
              href={talk.url}
              target="_blank"
              rel="noopener noreferrer"
            >{talk.venue}<span aria-hidden="true">{' ↗︎'}</span></a>
            <span class="talk-year label">{talk.year}</span>
            <span class="talk-role">{talk.role}</span>
            {talk.topic && <span class="talk-topic">{talk.topic}</span>}
          </li>
        ))}
      </ul>
    </section>

  </div>
</Garden>

<style>
  .hive-wrap {
    padding-block: var(--space-16);
  }

  .hive-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .hive-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hive-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 640px;
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  .flock-section {
    margin-bottom: var(--space-20);
  }

  .hats-section {
    margin-bottom: var(--space-20);
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }

  .hats-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: var(--space-8);
  }



  .talks-section {
    margin-bottom: var(--space-20);
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }

  .talks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 640px;
  }

  .talk {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: baseline;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--ink-faint);
  }

  .talk-venue {
    font-size: var(--text-md);
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    justify-self: start;
    transition: color var(--duration-fast) var(--easing);
  }

  .talk-venue:hover {
    color: var(--ink-muted);
  }

  .talk-year {
    color: var(--ink-muted);
    text-align: right;
  }

  .talk-role {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .talk-topic {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
