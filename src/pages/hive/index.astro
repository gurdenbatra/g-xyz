---
import Garden from '@layouts/Garden.astro';
import LiveFlock from '../../components/zones/Hive/LiveFlock.astro';
import { hats } from '../../lib/hats';
import { talks } from '../../lib/talks';
---

<Garden
  title="The Hive"
  description="What I'm working on now, the practices behind it, how to reach me, and where I've spoken."
>
  <div class="hive-wrap page-wrap">

    <header class="hive-header">
      <h1>The Hive</h1>
      <p class="hive-intro">
        What I'm carrying right now, the many practices the work draws on,
        how to reach me — and where I've spoken along the way.
      </p>
    </header>

    <section class="flock-section" aria-labelledby="flock-heading">
      <h2 id="flock-heading" class="label section-heading">Live Swarm</h2>
      <LiveFlock />
    </section>

    <section class="hats-section" aria-labelledby="hats-heading">
      <h2 id="hats-heading" class="label section-heading">Hats I wear</h2>
      <p class="hats-intro">
        One role on paper, many in practice — the work at Dark Matter Labs spans
        strategy to shipping code.
      </p>
      <ul class="hats-list" role="list">
        {hats.map((hat) => <li class="hat label">{hat}</li>)}
      </ul>
    </section>

    <section class="talks-section" aria-labelledby="talks-heading">
      <h2 id="talks-heading" class="label section-heading">Talks</h2>
      <ul class="talks-list" role="list">
        {talks.map((talk) => (
          <li class="talk">
            <a
              class="talk-venue"
              href={talk.url}
              target="_blank"
              rel="noopener noreferrer"
            >{talk.venue}<span aria-hidden="true">{' ↗︎'}</span></a>
            <span class="talk-year label">{talk.year}</span>
            <span class="talk-role">{talk.role}</span>
            {talk.topic && <span class="talk-topic">{talk.topic}</span>}
          </li>
        ))}
      </ul>
    </section>

  </div>
</Garden>

<style>
  .hive-wrap {
    padding-block: var(--space-16);
  }

  .hive-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-8);
  }

  .hive-header h1 {
    font-size: var(--text-3xl);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hive-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-8);
  }

  .flock-section {
    margin-bottom: var(--space-20);
  }

  .hats-section {
    margin-bottom: var(--space-20);
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }

  .hats-intro {
    font-size: var(--text-md);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  .hats-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hat {
    border: 1px solid var(--ink-muted);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-xs);
  }

  .talks-section {
    margin-bottom: var(--space-20);
    padding-top: var(--space-12);
    border-top: 1px solid var(--ink-faint);
  }

  .talks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 640px;
  }

  .talk {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    align-items: baseline;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--ink-faint);
  }

  .talk-venue {
    font-size: var(--text-md);
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    justify-self: start;
    transition: color var(--duration-fast) var(--easing);
  }

  .talk-venue:hover {
    color: var(--ink-muted);
  }

  .talk-year {
    color: var(--ink-muted);
    text-align: right;
  }

  .talk-role {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .talk-topic {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
