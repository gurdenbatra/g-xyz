---
interface Props {
  index: number;
  title: string;
  tag: string;
  year: number;
  slug: string;
  description?: string;
}

const { index, title, tag, year, slug, description } = Astro.props;
const num = String(index).padStart(2, '0');
---

<a href={`/work/${slug}`} class="project-row">
  <div class="project-main">
    <span class="project-title">{title}</span>
    {description && (
      <span class="project-desc">{description}</span>
    )}
  </div>
  <div class="project-meta">
    <span class="project-tag">{tag}</span>
    <span class="project-year">{year}</span>
  </div>
</a>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-4);
    border-bottom: 1px solid var(--ink-faint);
    text-decoration: none;
    color: inherit;
    align-items: start;
    transition: background var(--duration-fast) var(--easing),
                border-left-color var(--duration-fast) var(--easing);
    border-left: 2px solid transparent;
    margin-left: -2px;
  }

  .project-row:hover {
    background: color-mix(in srgb, var(--ink) 4%, var(--ground));
    border-left-color: var(--ink);
  }

  .project-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .project-title {
    font-family: 'MaziusDisplay', serif;
    font-size: var(--text-lg);
    color: var(--ink);
    line-height: 1.1;
  }

  .project-desc {
    font-family: 'NectoMono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    padding-top: 2px;
    flex-shrink: 0;
  }

  .project-tag,
  .project-year {
    font-family: 'NectoMono', monospace;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .project-tag {
    text-transform: uppercase;
  }

  @media (max-width: 500px) {
    .project-row {
      grid-template-columns: 1fr;
    }

    .project-meta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }
  }
</style>
