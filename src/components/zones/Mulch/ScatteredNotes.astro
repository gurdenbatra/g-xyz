---
// src/components/zones/Mulch/ScatteredNotes.astro
import type { CollectionEntry } from 'astro:content';
import { positionNote, KIND_STYLE } from '../../../lib/scatter';

interface Props {
  pieces: CollectionEntry<'mulch'>[];
}

const { pieces } = Astro.props;

const positionedPieces = pieces.map(piece => {
  const slug = piece.id.replace(/\.[^.]+$/, '');
  const { leftPct, topPx, r, bg, fg } = positionNote(slug, piece.data.kind);
  return { piece, slug, leftPct, topPx, r, bg, fg };
});

// The colour key is generated from KIND_STYLE so the swatches can never drift
// from the note colours they document.
const legend = [
  { label: 'Poem', kind: 'poem' },
  { label: 'Essay', kind: 'essay' },
  { label: 'Music', kind: 'music' },
  { label: 'A/V', kind: 'av' },
] as const;
---

<div class="scatter-wrap" data-scatter-wrap>
  {positionedPieces.map(({ piece, leftPct, topPx, r, bg, fg }) => (
    <a
      href={piece.data.url ?? '#'}
      class="note"
      data-note
      target="_blank"
      rel="noopener noreferrer"
      data-left-pct={leftPct}
      data-top-px={topPx}
      data-r={r}
      style={`left:${leftPct}%;top:${topPx}px;transform:rotate(${r}deg);background:${bg};color:${fg};`}
    >
      <span class="note-kind">{piece.data.kind}<span class="note-arrow" aria-hidden="true"> ↗</span></span>
      <span class="note-title">{piece.data.title}</span>
      {piece.data.description && <span class="note-desc">{piece.data.description}</span>}
      {piece.data.year && <span class="note-year">{piece.data.year}</span>}
    </a>
  ))}

  <div class="colour-key" data-colour-key aria-hidden="true">
    <span class="key-label">Key:</span>
    {legend.map(({ label, kind }) => (
      <span class="key-item"
        ><span class="key-swatch" style={`background:${KIND_STYLE[kind].bg}`}></span>{label}</span
      >
    ))}
  </div>
</div>

<style>
  .scatter-wrap {
    position: relative;
    height: 620px;
    overflow: visible;
    margin-bottom: var(--space-8, 2rem);
  }

  .note {
    position: absolute;
    padding: 10px 14px;
    border-radius: 1px;
    font-style: italic;
    cursor: pointer;
    text-decoration: none;
    max-width: 150px;
    box-shadow: 2px 3px 8px rgba(0, 0, 0, 0.18);
    transition: box-shadow 0.2s, filter 0.2s;
    transform-origin: top center;
  }

  .note:hover {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
    filter: brightness(1.06);
    z-index: 10;
  }

  .note:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    z-index: 10;
  }

  .note-kind {
    display: block;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    /* Full opacity: the note backgrounds (esp. moss green) leave no contrast
       headroom to fade small text and still clear WCAG AA — hierarchy is
       carried by font size instead. */
    opacity: 1;
    margin-bottom: 4px;
    font-style: normal;
  }

  .note-title {
    display: block;
    font-size: 11px;
    line-height: 1.4;
  }

  .note-desc {
    display: block;
    font-size: 9px;
    opacity: 1;
    margin-top: 3px;
    line-height: 1.4;
  }

  .note-year {
    display: block;
    font-size: 8px;
    opacity: 1;
    margin-top: 5px;
    font-style: normal;
  }

  .colour-key {
    position: absolute;
    bottom: 16px;
    left: 0;
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .key-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-muted);
  }

  .key-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    color: var(--ink-muted);
    font-style: normal;
  }

  .key-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  /* Phones can't fit 4 absolute columns — flow the notes into a centered wrap
     instead. !important beats both the SSG inline positions and the wind
     script's inline transform. */
  @media (max-width: 640px) {
    .scatter-wrap {
      height: auto !important;
      min-height: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-content: flex-start;
      gap: var(--space-3);
      padding-bottom: var(--space-10);
    }

    .note {
      position: static !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      max-width: 160px;
    }

    .colour-key {
      position: static;
      flex-basis: 100%;
      justify-content: center;
      margin-top: var(--space-6);
    }
  }
</style>

<script>
  import { noise2D } from '../../../lib/noise';

  let cleanup: (() => void) | null = null;

  function mount(): void {
    const wrap = document.querySelector<HTMLElement>('[data-scatter-wrap]');
    if (!wrap) return;

    const notes = Array.from(wrap.querySelectorAll<HTMLElement>('[data-note]'));
    if (notes.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return; // inline styles from SSG already set correct positions

    const H = wrap.clientHeight || 420; // scatter container height in px

    // Pre-compute per-note constants (dataset values never change)
    const noteData = notes.map(note => ({
      el:      note,
      br:      parseFloat(note.dataset.r       ?? '0'),
      leftPct: parseFloat(note.dataset.leftPct ?? '0'),
      topPx:   parseFloat(note.dataset.topPx   ?? '0'),
    }));

    let rafId: number;

    function tick(): void {
      const t = performance.now() / 4000;
      const W = wrap!.clientWidth;
      if (W === 0) {
        rafId = requestAnimationFrame(tick);
        return;
      }

      noteData.forEach(nd => {
        const x  = (nd.leftPct / 100) * W;
        const y  = nd.topPx;

        const nx    = x / W;
        const ny    = y / H;
        const windR  = noise2D(nx + t, ny + t) * 4;
        const driftY = noise2D(nx, ny + t * 0.5) * 3;

        nd.el.style.transform = `rotate(${nd.br + windR}deg) translateY(${driftY}px)`;
      });

      rafId = requestAnimationFrame(tick);
    }

    rafId = requestAnimationFrame(tick);
    cleanup = (): void => cancelAnimationFrame(rafId);
  }

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    mount();
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
