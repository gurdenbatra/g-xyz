---
import { groundFrame } from '../../lib/ascii-earth';

const earthLine = groundFrame(240, 0);
const SPECK_ROWS = [
  '·     .        :      .         ·       .          :     .       ·      .',
  '   .       ·         .      :        .        ·        .     :        .',
] as const;
---

<div class="ascii-earth" aria-hidden="true">
  <pre class="ascii-earth__line" data-earth-line>{earthLine}</pre>
  <pre class="ascii-earth__specks">{SPECK_ROWS[0]}</pre>
  <pre class="ascii-earth__specks ascii-earth__specks--two">{SPECK_ROWS[1]}</pre>
</div>

<style>
  .ascii-earth {
    pointer-events: none;
    width: 100%;
    overflow: hidden;
  }

  .ascii-earth pre {
    margin: 0;
    font-family: var(--font-mono);
    white-space: pre;
    overflow: hidden;
    text-align: center;
    line-height: 1;
  }

  .ascii-earth__line {
    font-size: 13px;
    color: var(--c-soil);
    opacity: 0.4;
  }

  /* Applied by the pretext animation island (Task 5): switches to proportional
     Georgian italic so variable-typographic char selection works correctly. */
  .ascii-earth__line--vivid {
    font-family: Georgia, serif;
    font-style: italic;
  }

  .ascii-earth__specks {
    display: none;
    font-size: 11px;
    color: var(--c-soil);
    opacity: 0.2;
  }

  @media (min-width: 768px) {
    .ascii-earth {
      position: absolute;
      left: 0;
      right: 0;
      top: 62%;
      z-index: 0;
    }

    .ascii-earth__specks {
      display: block;
      margin-top: 0.9rem;
    }

    .ascii-earth__specks--two {
      opacity: 0.14;
      margin-top: 1.1rem;
    }
  }
</style>

<script>
  import { groundHeight, pickChar, type CharMetric } from '../../lib/ascii-earth';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    const COLUMNS = 240; // must match the server-side groundFrame(240, 0) call
    const FRAME_MS = 80; // ~12 fps intentional — ornamental, not smooth

    let el: HTMLElement | null = null;
    let rafId: number | null = null;
    let metrics: CharMetric[] | null = null; // measured once, reused across visits
    let cellWidth = 0;
    let loading = false;
    let last = 0;

    function stop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function tick(now: number) {
      if (!document.hidden && el && metrics && now - last >= FRAME_MS) {
        last = now;
        const t = now / 1000;
        let line = '';
        for (let i = 0; i < COLUMNS; i++) {
          line += pickChar(metrics, groundHeight(i, t), cellWidth);
        }
        el.textContent = line;
      }
      rafId = requestAnimationFrame(tick);
    }

    // Re-acquire the (freshly swapped) line and (re)start the loop. Safe to call
    // on every page-load — this is what makes the ripple survive returning to
    // the homepage after a view-transition, instead of freezing forever.
    function run() {
      el = document.querySelector<HTMLElement>('[data-earth-line]');
      if (!el || !metrics) return;
      el.classList.add('ascii-earth__line--vivid');
      stop();
      rafId = requestAnimationFrame(tick);
    }

    // Measure character widths once (the expensive pretext import); then run.
    async function ensureMetrics() {
      if (metrics || loading) return;
      loading = true;
      try {
        const pretext = await import('@chenglou/pretext');
        const font = 'italic 13px Georgia, serif';
        // Hand-tuned perceived ink density per character — height is used as a
        // brightness proxy so taller terrain maps to denser, heavier chars.
        const BRIGHTNESS: Record<string, number> = {
          '.': 0.15, "'": 0.2, ',': 0.3, '-': 0.4, '~': 0.55,
          ':': 0.6, ';': 0.7, '^': 0.8, '"': 0.85, '*': 1,
        };
        const measured: CharMetric[] = Object.keys(BRIGHTNESS).map((ch) => {
          const prepared = pretext.prepareWithSegments(ch, font);
          return {
            char: ch,
            width: pretext.measureNaturalWidth(prepared),
            brightness: BRIGHTNESS[ch],
          };
        });
        const cell = measured.find((m) => m.char === '~');
        if (!cell || !measured.every((m) => Number.isFinite(m.width) && m.width > 0)) return;
        metrics = measured;
        cellWidth = cell.width;
        run();
      } catch {
        // pretext unavailable or measurement failed — static frame stands
      } finally {
        loading = false;
      }
    }

    function onLoad() {
      if (!document.querySelector('[data-earth-line]')) {
        stop(); // not on the homepage — go quiet
        return;
      }
      if (metrics) {
        run(); // already measured — just restart against the fresh element
        return;
      }
      const ric = (
        window as Window & {
          requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void;
        }
      ).requestIdleCallback;
      // The { timeout } guarantees start even on a page that never goes idle
      // (dev HMR sockets, prefetch keepalive), while still deferring past LCP.
      if (typeof ric === 'function') ric(() => void ensureMetrics(), { timeout: 2000 });
      else setTimeout(() => void ensureMetrics(), 200);
    }

    // Bind only on page-load (it fires on the initial load too) so the ripple
    // both starts and *restarts* on every homepage visit; stop before a swap.
    document.addEventListener('astro:page-load', onLoad);
    document.addEventListener('astro:before-preparation', stop);
  }
</script>
